{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "GESTLOG — Node (NestJS)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Prisma 5 usa Proxy no construtor do PrismaClient; useDefineForClassFields
    // sobrescreveria os acessores do Proxy em subclasses, deixando prisma.user
    // undefined. Mantemos false para código de servidor.
    "useDefineForClassFields": false
  }
}
