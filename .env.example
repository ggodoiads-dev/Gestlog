# === Ambiente ===
NODE_ENV=development
TZ=America/Sao_Paulo
LOG_LEVEL=info

# === URLs ===
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DRIVER_BASE_URL=http://localhost:3100

# === Postgres ===
DATABASE_URL=postgres://gestlog:gestlog@localhost:5432/gestlog
# Role somente para a aplicacao (sem BYPASSRLS):
DATABASE_APP_URL=postgres://gestlog_app:gestlog_app@localhost:5432/gestlog
# Role administrativa (bypassa RLS; uso auditado):
DATABASE_ADMIN_URL=postgres://gestlog_admin:gestlog_admin@localhost:5432/gestlog

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth ===
AUTH_SECRET=change-me-with-a-32+-char-random-value
AUTH_URL=http://localhost:3000
SESSION_MAX_AGE_SECONDS=28800

# === E-mail (dev: Mailhog) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GESTLOG <no-reply@gestlog.local>"

# === Observabilidade ===
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gestlog-api

# === Feature flags ===
FEATURE_DEMO_SEEDS=true
