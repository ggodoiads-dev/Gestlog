{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @gestlog/db prisma:generate && pnpm --filter @gestlog/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @gestlog/db prisma:migrate:deploy && node apps/api/dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
